@page "/sistem-benzi-m23"

<style>
    /* Animație realistă pentru benzile transportoare */
    .banda-mecanica {
        background: repeating-linear-gradient(
            -45deg,
            #374151,
            #374151 15px,
            #1f2937 15px,
            #1f2937 30px
        );
        transition: background-position 0.1s linear;
    }
    .banda-activa {
        animation: miscare-banda 1s linear infinite;
        border-color: #10b981 !important; /* Verde cand merge */
        box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
    }
    @@keyframes miscare-banda {
        0% { background-position: 0 0; }
        100% { background-position: 42.42px 0; }
    }
    
    .alarma-activa {
        animation: flash-alarma 0.5s alternate infinite;
    }
    @@keyframes flash-alarma {
        from { background-color: #ef4444; color: white; }
        to { background-color: #7f1d1d; color: white; }
    }
</style>

<div class="min-h-screen bg-gray-900 text-white p-6 font-sans @(IsAlarmActive ? "alarma-activa" : "")">
    
    <div class="flex justify-between items-center mb-8 bg-gray-800 p-4 rounded-lg border border-gray-700">
        <div>
            <h1 class="text-3xl font-bold text-blue-400">Sistem de încărcare cu benzi (M23)</h1>
            <p class="text-gray-400 mt-1">Interfață HMI - Control Procese</p>
        </div>
        <div class="flex flex-col items-end">
            <span class="text-sm text-gray-400 mb-2">Mod Funcționare:</span>
            <div class="flex space-x-2">
                <button class="px-4 py-2 rounded-md font-bold transition @(CurrentMode == 1 ? "bg-blue-600 text-white" : "bg-gray-700 text-gray-400 hover:bg-gray-600")"
                        @onclick="() => SetMode(1)" disabled="@IsAlarmActive">
                    Funcționalitatea 1
                </button>
                <button class="px-4 py-2 rounded-md font-bold transition @(CurrentMode == 2 ? "bg-purple-600 text-white" : "bg-gray-700 text-gray-400 hover:bg-gray-600")"
                        @onclick="() => SetMode(2)" disabled="@IsAlarmActive">
                    Funcționalitatea 2
                </button>
            </div>
        </div>
    </div>

    @if (IsAlarmActive)
    {
        <div class="bg-red-600 text-white font-bold text-center p-4 rounded-lg mb-6 text-xl tracking-widest shadow-lg border-2 border-red-300">
            ⚠️ ALARMĂ CRITICĂ: SENZORI BLOCAȚI - SISTEM OPRIT (Se resetează automat...) ⚠️
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <div class="lg:col-span-2 bg-gray-800 p-6 rounded-lg border border-gray-700 flex flex-col items-center relative">
            <h2 class="text-xl font-semibold mb-6 text-gray-300 w-full border-b border-gray-600 pb-2">Vizualizare Proces</h2>
            
            <div class="flex justify-between w-full max-w-2xl mb-2">
                <div class="flex flex-col items-center">
                    <span class="mb-2 font-bold @(Band1 ? "text-green-400" : "text-gray-500")">Banda 1 (M1)</span>
                    <div class="w-32 h-16 rounded-full border-4 border-gray-600 banda-mecanica @(Band1 ? "banda-activa" : "")"></div>
                </div>
                <div class="flex flex-col items-center">
                    <span class="mb-2 font-bold @(Band2 ? "text-green-400" : "text-gray-500")">Banda 2 (M2)</span>
                    <div class="w-32 h-16 rounded-full border-4 border-gray-600 banda-mecanica @(Band2 ? "banda-activa" : "")"></div>
                </div>
            </div>

            <div class="w-64 h-40 bg-gray-900 border border-gray-600 rounded-lg flex items-center justify-center relative my-4 shadow-inner">
                <span class="absolute top-2 left-2 text-xs text-gray-500">Punct Intersecție</span>
                <span class="absolute top-2 right-2 text-sm font-bold text-yellow-400">Clapetă: @FlapState</span>
                
                <svg width="150" height="100" viewBox="0 0 150 100" class="mt-4">
                    @if (FlapState == "S6")
                    {
                        <path d="M 20 0 L 20 100" stroke="@(Band1 && Band3 ? "#10b981" : "#4b5563")" stroke-width="8" fill="none" class="@(Band1 && Band3 ? "animate-pulse" : "")" />
                        <path d="M 130 0 L 130 100" stroke="@(Band2 && Band4 ? "#10b981" : "#4b5563")" stroke-width="8" fill="none" class="@(Band2 && Band4 ? "animate-pulse" : "")" />
                    }
                    else if (FlapState == "S7")
                    {
                        <path d="M 20 0 Q 75 50 20 100" stroke="@(Band1 && Band3 ? "#10b981" : "#4b5563")" stroke-width="8" fill="none" class="@(Band1 && Band3 ? "animate-pulse" : "")" />
                        <path d="M 130 0 Q 75 50 130 100" stroke="@(Band2 && Band4 ? "#10b981" : "#4b5563")" stroke-width="8" fill="none" class="@(Band2 && Band4 ? "animate-pulse" : "")" />
                        <circle cx="75" cy="50" r="10" fill="#f59e0b" /> }
                    else if (FlapState == "S8")
                    {
                        <path d="M 20 0 L 130 100" stroke="@(Band1 && Band4 ? "#10b981" : "#4b5563")" stroke-width="8" fill="none" class="@(Band1 && Band4 ? "animate-pulse" : "")" />
                        <path d="M 130 0 L 20 100" stroke="@(Band2 && Band3 ? "#10b981" : "#4b5563")" stroke-width="8" fill="none" class="@(Band2 && Band3 ? "animate-pulse" : "")" />
                    }
                </svg>
            </div>

            <div class="flex justify-between w-full max-w-2xl mt-2">
                <div class="flex flex-col items-center">
                    <div class="w-32 h-16 rounded-full border-4 border-gray-600 banda-mecanica @(Band3 ? "banda-activa" : "")"></div>
                    <span class="mt-2 font-bold @(Band3 ? "text-green-400" : "text-gray-500")">Banda 3 (M3)</span>
                </div>
                <div class="flex flex-col items-center">
                    <div class="w-32 h-16 rounded-full border-4 border-gray-600 banda-mecanica @(Band4 ? "banda-activa" : "")"></div>
                    <span class="mt-2 font-bold @(Band4 ? "text-green-400" : "text-gray-500")">Banda 4 (M4)</span>
                </div>
            </div>
        </div>

        <div class="bg-gray-800 p-6 rounded-lg border border-gray-700 flex flex-col">
            <h2 class="text-xl font-semibold mb-6 text-gray-300 border-b border-gray-600 pb-2">Panou de Comandă</h2>

            <div class="grid grid-cols-2 gap-4 mb-8">
                <button class="bg-red-700 hover:bg-red-600 text-white font-bold py-3 px-4 rounded shadow-lg active:scale-95 transition"
                        @onclick="S0_StopAll" disabled="@IsAlarmActive">
                    [S0] Oprire Totală
                </button>
                <button class="bg-orange-600 hover:bg-orange-500 text-white font-bold py-3 px-4 rounded shadow-lg active:scale-95 transition"
                        @onclick="S5_StopInputs" disabled="@IsAlarmActive">
                    [S5] Oprește Benzi 1+2
                </button>
            </div>

            <div class="mb-8 bg-gray-900 p-4 rounded-lg border border-gray-700">
                <span class="text-sm text-gray-400 block mb-3 font-bold uppercase tracking-wide">Mecanism Selecție Clapetă</span>
                <div class="flex justify-between space-x-2">
                    <button class="flex-1 py-2 rounded font-bold @(FlapState == "S6" ? "bg-yellow-500 text-gray-900" : "bg-gray-700 text-gray-300 hover:bg-gray-600")"
                            @onclick='() => ChangeFlap("S6")' disabled="@IsAlarmActive">S6 (||)</button>
                    <button class="flex-1 py-2 rounded font-bold @(FlapState == "S7" ? "bg-yellow-500 text-gray-900" : "bg-gray-700 text-gray-300 hover:bg-gray-600")"
                            @onclick='() => ChangeFlap("S7")' disabled="@IsAlarmActive">S7 (Y)</button>
                    <button class="flex-1 py-2 rounded font-bold @(FlapState == "S8" ? "bg-yellow-500 text-gray-900" : "bg-gray-700 text-gray-300 hover:bg-gray-600")"
                            @onclick='() => ChangeFlap("S8")' disabled="@IsAlarmActive">S8 (X)</button>
                </div>
            </div>

            <span class="text-sm text-gray-400 block mb-3 font-bold uppercase tracking-wide">Comenzi Benzi Individuale</span>
            <div class="grid grid-cols-2 gap-4 flex-grow">
                <button class="py-3 rounded font-bold shadow-md transition relative overflow-hidden @(Band1 ? "bg-green-600 text-white" : "bg-gray-700 text-gray-300 hover:bg-gray-600")"
                        @onclick="ToggleBand1" disabled="@IsAlarmActive">
                    [S1] Banda 1
                    @if(Band1) { <span class="absolute right-2 top-2 w-3 h-3 bg-green-300 rounded-full animate-pulse"></span> }
                </button>
                <button class="py-3 rounded font-bold shadow-md transition relative overflow-hidden @(Band2 ? "bg-green-600 text-white" : "bg-gray-700 text-gray-300 hover:bg-gray-600")"
                        @onclick="ToggleBand2" disabled="@IsAlarmActive">
                    [S2] Banda 2
                    @if(Band2) { <span class="absolute right-2 top-2 w-3 h-3 bg-green-300 rounded-full animate-pulse"></span> }
                </button>
                <button class="py-3 rounded font-bold shadow-md transition relative overflow-hidden @(Band3 ? "bg-green-600 text-white" : "bg-gray-700 text-gray-300 hover:bg-gray-600")"
                        @onclick="ToggleBand3" disabled="@IsAlarmActive">
                    [S3] Banda 3
                    @if(Band3) { <span class="absolute right-2 top-2 w-3 h-3 bg-green-300 rounded-full animate-pulse"></span> }
                </button>
                <button class="py-3 rounded font-bold shadow-md transition relative overflow-hidden @(Band4 ? "bg-green-600 text-white" : "bg-gray-700 text-gray-300 hover:bg-gray-600")"
                        @onclick="ToggleBand4" disabled="@IsAlarmActive">
                    [S4] Banda 4
                    @if(Band4) { <span class="absolute right-2 top-2 w-3 h-3 bg-green-300 rounded-full animate-pulse"></span> }
                </button>
            </div>

            @if (CurrentMode == 2)
            {
                <div class="mt-8 border-t border-gray-600 pt-4">
                    <button class="w-full bg-red-900 border border-red-500 hover:bg-red-800 text-red-200 font-bold py-3 px-4 rounded flex items-center justify-center space-x-2 transition"
                            @onclick="TriggerErrorSimulation" disabled="@IsAlarmActive">
                        <span>⚠️ Simulare Eroare Senzori (2 Blocaje)</span>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // Stări Benzi (Motors M1-M4)
    private bool Band1 { get; set; } = false;
    private bool Band2 { get; set; } = false;
    private bool Band3 { get; set; } = false;
    private bool Band4 { get; set; } = false;

    // Stare Intersecție / Clapetă
    private string FlapState { get; set; } = "S6"; // S6, S7, S8

    // Mod Funcționare și Erori
    private int CurrentMode { get; set; } = 1;
    private bool IsAlarmActive { get; set; } = false;

    private void SetMode(int mode)
    {
        CurrentMode = mode;
        S0_StopAll(); // Oprire de siguranță la schimbarea modului
    }

    private void ChangeFlap(string newState)
    {
        FlapState = newState;
        ValidateInputs(); // Re-evaluăm regulile când se schimbă direcția
    }

    private void S0_StopAll()
    {
        Band1 = false; Band2 = false; Band3 = false; Band4 = false;
    }

    private void S5_StopInputs()
    {
        Band1 = false; Band2 = false;
    }

    // --- LOGICA DE DESCRIERE FUNCȚIONALĂ ---

    private void ToggleBand3() { Band3 = !Band3; ValidateInputs(); }
    private void ToggleBand4() { Band4 = !Band4; ValidateInputs(); }

    private void ToggleBand1()
    {
        if (Band1) { Band1 = false; return; } // Poate fi oprit oricând
        
        if (CurrentMode == 1)
        {
            // Doar una poate rula
            if (Band2) return; 
            
            // Doar dacă ieșirea corespunzătoare e pornită
            if (FlapState == "S6" && Band3) Band1 = true;
            if (FlapState == "S7" && (Band3 || Band4)) Band1 = true; 
            if (FlapState == "S8" && Band4) Band1 = true;
        }
        else if (CurrentMode == 2)
        {
            // În modul 2, B1 poate fi pornită și simultan cu B2 dacă S7 permite și ieșirile rulează
            if (FlapState == "S7" && Band3 && Band4) Band1 = true;
            else if (FlapState == "S6" && Band3) Band1 = true;
            else if (FlapState == "S8" && Band4) Band1 = true;
        }
    }

    private void ToggleBand2()
    {
        if (Band2) { Band2 = false; return; }
        
        if (CurrentMode == 1)
        {
            if (Band1) return; 
            
            if (FlapState == "S6" && Band4) Band2 = true;
            if (FlapState == "S7" && (Band3 || Band4)) Band2 = true;
            if (FlapState == "S8" && Band3) Band2 = true;
        }
        else if (CurrentMode == 2)
        {
            if (FlapState == "S7" && Band3 && Band4) Band2 = true;
            else if (FlapState == "S6" && Band4) Band2 = true;
            else if (FlapState == "S8" && Band3) Band2 = true;
        }
    }

    // Oprește automat benzile de intrare dacă nu mai sunt respectate condițiile (ex: oprim o bandă de ieșire)
    private void ValidateInputs()
    {
        if (CurrentMode == 1)
        {
            if (Band1 && Band2) { Band1 = false; Band2 = false; } // Interblocare strictă

            if (Band1)
            {
                if (FlapState == "S6" && !Band3) Band1 = false;
                if (FlapState == "S8" && !Band4) Band1 = false;
                if (FlapState == "S7" && !Band3 && !Band4) Band1 = false;
            }
            if (Band2)
            {
                if (FlapState == "S6" && !Band4) Band2 = false;
                if (FlapState == "S8" && !Band3) Band2 = false;
                if (FlapState == "S7" && !Band3 && !Band4) Band2 = false;
            }
        }
        else if (CurrentMode == 2)
        {
            if (Band1 && Band2 && (FlapState != "S7" || !Band3 || !Band4))
            {
                // Funcționarea simultană se oprește dacă S7 nu mai e pe mijloc sau ieșirile se opresc
                S5_StopInputs(); 
            }
            else
            {
                // Condiții individuale
                if (Band1 && FlapState == "S6" && !Band3) Band1 = false;
                if (Band1 && FlapState == "S8" && !Band4) Band1 = false;
                if (Band2 && FlapState == "S6" && !Band4) Band2 = false;
                if (Band2 && FlapState == "S8" && !Band3) Band2 = false;
            }
        }
    }

    // Simulare alarma de 5 secunde
    private async Task TriggerErrorSimulation()
    {
        IsAlarmActive = true;
        S0_StopAll(); // Toate benzile oprite
        StateHasChanged();
        
        await Task.Delay(5000); // Așteaptă 5 secunde
        
        IsAlarmActive = false;
        StateHasChanged();
    }
}